# Copy file này thành automation/.env rồi điền. KHÔNG commit file .env (đã có trong .gitignore).

# --- Odoo (External API) ---
ODOO_URL=https://choi.odoo.com
ODOO_DB=choi
ODOO_USER=email-dang-nhap-odoo@example.com
# Odoo: avatar > Hồ sơ của tôi / My Profile > Bảo mật tài khoản / Account Security > New API Key
ODOO_API_KEY=
# ID nhóm Helpdesk (xem trên URL: /odoo/helpdesk/1/tickets -> 1). 0 = mọi nhóm
ODOO_TEAM_ID=1
ODOO_LANG=vi_VN
# Bot chỉ lấy ticket ở giai đoạn ODOO_STAGE_NEW (ticket mới đến)
ODOO_STAGE_NEW=Mới
ODOO_STAGE_WAITING=Waiting Customer
ODOO_STAGE_ESCALATED=Escalated

# --- HR + LMS (mặc định: mock_services.py chạy ở cổng 8090) ---
HR_API_URL=http://127.0.0.1:8090/hr
LMS_API_URL=http://127.0.0.1:8090/lms

# --- Hành vi bot ---
# false = email trả lời chỉ được lưu thành ghi chú trên ticket (không gửi thật)
LOGIN_BOT_SEND_EMAIL=false
# Ticket mang các tag này bị bỏ qua (ticket mẫu import từ sample.xlsx)
LOGIN_BOT_SKIP_TAGS=week5-sample
LOGIN_BOT_TIMEOUT=5
LOGIN_BOT_RETRIES=3
# Token bí mật cho webhook (Odoo gọi .../odoo/ticket?token=...)
LOGIN_BOT_WEBHOOK_TOKEN=
